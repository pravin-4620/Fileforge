MONGODB_URI=mongodb://127.0.0.1:27017/fileforge
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=5001
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=500
FILE_RETENTION_HOURS=24
CONVERSION_CONCURRENCY=2
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ONLYOFFICE_URL=http://127.0.0.1:8080
ONLYOFFICE_INTERNAL_URL=http://host.docker.internal:5001
ONLYOFFICE_JWT_SECRET=replace-with-a-separate-random-secret
SERVE_CLIENT=true
# Optional binary overrides
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# LIBREOFFICE_PATH=/usr/local/bin/libreoffice
# SEVENZIP_PATH=/usr/local/bin/7z
# IMAGEMAGICK_PATH=/usr/local/bin/magick
# PDF2DOCX_PATH=./.venv/bin/pdf2docx
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
